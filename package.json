{
  "name": "commitcraft-ai-smart-git-commits",
  "displayName": "CommitCraft AI: Smart Git Commits",
  "description": "AI-powered Git commit messages from your local changes. Review files, generate a structured message via OpenRouter, then commit, push, or undo — always with your confirmation.",
  "version": "0.3.1",
  "publisher": "CommitCraftAISmartGitCommits",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "openrouter",
    "source-control",
    "conventional-commits",
    "commit-message",
    "productivity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommyqhoang/CommitCraft-AI-Smart-Git-Commits.git"
  },
  "bugs": {
    "url": "https://github.com/tommyqhoang/CommitCraft-AI-Smart-Git-Commits/issues"
  },
  "homepage": "https://github.com/tommyqhoang/CommitCraft-AI-Smart-Git-Commits#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onCommand:commitCraft.openCommitAssistant",
    "onCommand:commitCraft.generateCommitMessage",
    "onCommand:commitCraft.setOpenRouterToken",
    "onCommand:commitCraft.clearOpenRouterToken"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitCraft.openCommitAssistant",
        "title": "CommitCraft: Open Commit Assistant",
        "category": "CommitCraft",
        "icon": "$(sparkle)"
      },
      {
        "command": "commitCraft.generateCommitMessage",
        "title": "CommitCraft: Generate Smart Git Commit",
        "category": "CommitCraft"
      },
      {
        "command": "commitCraft.setOpenRouterToken",
        "title": "CommitCraft: Set OpenRouter API Token",
        "category": "CommitCraft"
      },
      {
        "command": "commitCraft.clearOpenRouterToken",
        "title": "CommitCraft: Clear OpenRouter API Token",
        "category": "CommitCraft"
      }
    ],
    "configuration": {
      "title": "CommitCraft",
      "properties": {
        "commitCraft.openRouterModel": {
          "type": "string",
          "default": "openrouter/auto",
          "description": "OpenRouter model used to generate commit messages."
        },
        "commitCraft.fallbackModel": {
          "type": "string",
          "default": "openrouter/free",
          "description": "Fallback OpenRouter model used when the primary model fails."
        },
        "commitCraft.maxDiffCharacters": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "Maximum diff characters sent to OpenRouter before truncation (1 000–200 000)."
        },
        "commitCraft.includeUntrackedFiles": {
          "type": "boolean",
          "default": true,
          "description": "Include safe untracked text files in CommitCraft prompt context."
        },
        "commitCraft.skipCommitConfirmation": {
          "type": "boolean",
          "default": false,
          "description": "Skip the confirmation dialog when committing. The panel itself serves as review."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "commitCraft.generateCommitMessage",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "commitCraft.openCommitAssistant",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "vscode:test": "npm run compile && node ./dist/test/runTest.js",
    "package": "npm run compile && npm run lint && npm run format:check && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
